# display manager choice (debconf shared/default-x-display-manager): psippr-desktop means greetd
# with the psippr login screen; takes effect on the next boot, a running display manager is kept
. /usr/share/debconf/confmodule
getent passwd _greetd >/dev/null 2>&1 && usermod -aG video,input,render _greetd 2>/dev/null || true
db_get shared/default-x-display-manager || RET=""
if [ "$RET" = psippr-desktop ]; then
    mkdir -p /etc/X11
    echo /usr/sbin/greetd > /etc/X11/default-display-manager
    ln -sf /usr/lib/systemd/system/greetd.service /etc/systemd/system/display-manager.service
    systemctl daemon-reload 2>/dev/null || true
else
    # greetd's own postinst enables greetd.service, whose alias display-manager.service would
    # replace the chosen display manager (e.g. gdm3) at the next boot: point it back
    DM_LINK=/etc/systemd/system/display-manager.service
    CHOSEN="$(basename "$(cat /etc/X11/default-display-manager 2>/dev/null)" 2>/dev/null)"
    if [ "$(basename "$(readlink "$DM_LINK" 2>/dev/null)" 2>/dev/null)" = greetd.service ] \
        && [ -n "$CHOSEN" ] && [ "$CHOSEN" != greetd ] && [ -f "/usr/lib/systemd/system/$CHOSEN.service" ]; then
        ln -sf "/usr/lib/systemd/system/$CHOSEN.service" "$DM_LINK"
        systemctl daemon-reload 2>/dev/null || true
    fi
fi
db_stop
